{
  "manifest_version": 2,
  "name": "Zen Data Saver",
  "version": "1.0",
  "description": "Blocks image downloads to save mobile data.",
  "browser_specific_settings": { "gecko": { "id": "datasaver@zenbrowser" } },
  "permissions": ["webRequest", "webRequestBlocking", "<all_urls>"],
  "background": { "scripts": ["background.js"] }
}
