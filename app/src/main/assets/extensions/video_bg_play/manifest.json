{
  "manifest_version": 2,
  "name": "Video Background Play Fix",
  "version": "1.0",
  "description": "Fix background play in browser when switching tabs",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-bg-play@zenbrowser.com"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
